rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The admin account. Firebase allows only one account per email, so this email can't be claimed by anyone else.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'jonah@wilderland.academy';
    }

    // Each player's saved progress: only they can read or write it.
    match /profiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.data is string && request.resource.data.data.size() < 900000;
    }

    // Leaderboard usernames: public to read, each name owned by one player.
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string && request.resource.data.name.size() <= 16;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Admin ticket adjustments: an admin queues a removal; the player's own game applies it on next load, then clears it.
    match /adjust/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if isAdmin();
    }

    // Global settings (current leaderboard season, full-reset time): everyone reads, only admins write.
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Leaderboards: anyone can read; signed-in players can post their own scores.
    match /boards/{game}/scores/{id} {
      function validScore() {
        return request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.s is number && request.resource.data.s >= 0 && request.resource.data.s < 1e300
          && request.resource.data.u is string && request.resource.data.u.size() <= 16;
      }
      allow read: if true;
      allow create: if validScore() && (game != '_tix' || id == request.auth.uid);
      allow update: if validScore() && game == '_tix' && id == request.auth.uid && resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
